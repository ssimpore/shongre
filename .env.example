# Shongre local orchestration. Copy with `make env-init` and keep secrets in
# .env.local or package-specific .env.local files.
APP_ENV=local
ENVIRONMENT_ID=shongre-local
API_ENVIRONMENT_ID=shongre-local
DATABASE_ENVIRONMENT_ID=shongre-local
SUPABASE_ENVIRONMENT_ID=shongre-local
STORAGE_ENVIRONMENT_ID=shongre-local

# Application hosts and host ports. These values are the single local source
# of truth; change them here rather than editing Makefile or package scripts.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
# Dedicated Playwright server; keep it separate from the interactive Web server.
E2E_FRONTEND_PORT=3110
# Comma-separated hostnames that are allowed to proxy the Next development server.
SHONGRE_ALLOWED_DEV_ORIGINS=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
EXPO_HOST=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_WEB_PORT=8082
STORYBOOK_PORT=6006

# Redis is the coordination transport for BullMQ and realtime fan-out. Native
# local processes use the loopback URL; Compose overrides it with the private
# `redis` service name. Hosted environments inject a protected TLS URL.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# Supabase host ports. Container-internal ports remain owned by Supabase.
SUPABASE_HOST=127.0.0.1
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_SHADOW_PORT=54320
SUPABASE_REALTIME_PORT=54323
SUPABASE_STUDIO_PORT=54324
SUPABASE_INBUCKET_PORT=54325
SUPABASE_SMTP_PORT=54326
SUPABASE_POP3_PORT=54330
SUPABASE_POOLER_PORT=54329

# Canonical deployment URLs. Local values may be regenerated from the host and
# port settings by scripts/env.sh. Hosted environments must supply their own
# HTTPS values through deployment configuration.
PUBLIC_FR_URL=http://127.0.0.1:3000
PUBLIC_INTL_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000

# Runtime application registry. Local development keeps one origin and uses the
# documented fallback routes. Hosted targets inject distinct HTTPS origins.
# These are public routing values, never authentication or Tunnel secrets.
SHONGRE_MARKETPLACE_ORIGIN=http://127.0.0.1:3000
SHONGRE_SOLUTIONS_ORIGIN=http://127.0.0.1:3000
SHONGRE_PROSPECTS_ORIGIN=http://127.0.0.1:3000
SHONGRE_FACTURATION_ORIGIN=http://127.0.0.1:3000

# Web runtime. Public values are derived from the canonical deployment values
# by scripts/env.sh and are never independent hostname configuration.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_ENVIRONMENT_ID=shongre-local
NEXT_PUBLIC_FR_URL=http://127.0.0.1:3000
NEXT_PUBLIC_INTL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_APP_NAME=Shongre
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=FR
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_LOCALE=fr-FR
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Analytics SDKs are runtime-configured and disabled unless explicitly enabled.
# The Cloudflare site tag and PostHog project key are public identifiers, never
# server credentials. Optional providers remain off in demo mode.
NEXT_PUBLIC_INTERNAL_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY_ENABLED=false
NEXT_PUBLIC_GA4_ENABLED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_MATOMO_ENABLED=false
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_SITE_TAG=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Both market URLs point at the same frontend deployment.
# `SHONGRE_TRUST_PROXY_HOST` may only be enabled behind a trusted proxy that
# overwrites (rather than forwards) X-Forwarded-Host.
SHONGRE_TRUST_PROXY_HOST=false
SHONGRE_TRUST_PROXY_IP=false
# Enable only when the trusted edge removes any inbound header with this name
# and injects its server-side IP-geolocation country result. The backend reads
# only the ISO country code and never reads or persists the raw address for
# market detection.
SHONGRE_TRUST_IP_COUNTRY_HEADER=false
SHONGRE_IP_COUNTRY_HEADER=cf-ipcountry

# Docker Compose images. Hosted deployment requires immutable @sha256 values;
# the local override builds these names from the current checkout.
FRONTEND_IMAGE=shongre-frontend:local
BACKEND_IMAGE=shongre-backend:local
SHONGRE_RUNTIME_ENV_FILE=.env.local
SHONGRE_FRONTEND_ENV_FILE=.env.example
CLOUDFLARE_TUNNEL_TOKEN_FILE=

# Backend runtime. Secrets intentionally have no example value.
# API_PREFIX is fixed by backend/openapi/openapi.json. A new prefix requires a
# new API major version rather than an environment-specific override.
API_PREFIX=/api/v1
BACKEND_DATA_MODE=database
# local starts the repository-owned Supabase/Docker stack; hosted connects to a
# separately managed staging or production Supabase project.
DATABASE_INFRA_MODE=local
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_COMPRESSION_MINIMUM_BYTES=1024
# Public response cache policy. Bump the key version for an emergency logical
# flush; cache tags remain market/domain scoped and never identify a user.
PUBLIC_CACHE_KEY_VERSION=v1
PUBLIC_CACHE_DISCOVERY_BROWSER_MAX_AGE_SECONDS=0
PUBLIC_CACHE_DISCOVERY_S_MAXAGE_SECONDS=15
PUBLIC_CACHE_DISCOVERY_SWR_SECONDS=30
PUBLIC_CACHE_DISCOVERY_STALE_IF_ERROR_SECONDS=120
PUBLIC_CACHE_CATALOG_BROWSER_MAX_AGE_SECONDS=0
PUBLIC_CACHE_CATALOG_S_MAXAGE_SECONDS=300
PUBLIC_CACHE_CATALOG_SWR_SECONDS=600
PUBLIC_CACHE_CATALOG_STALE_IF_ERROR_SECONDS=3600
PUBLIC_CACHE_REFERENCE_BROWSER_MAX_AGE_SECONDS=300
PUBLIC_CACHE_REFERENCE_S_MAXAGE_SECONDS=3600
PUBLIC_CACHE_REFERENCE_SWR_SECONDS=86400
PUBLIC_CACHE_REFERENCE_STALE_IF_ERROR_SECONDS=86400
# Validated commercial-catalog in-process resilience. This cache is market
# scoped and never stores account eligibility, quotes, balances, or permissions.
COMMERCIAL_CATALOG_FRESH_TTL_MS=60000
COMMERCIAL_CATALOG_STALE_IF_ERROR_MS=300000
COMMERCIAL_CATALOG_TTL_JITTER_RATIO=0.1
DISCOVERY_CANDIDATE_LIMIT=500
DATABASE_REQUEST_TIMEOUT_MS=10000
DATABASE_HEALTH_CHECK_TIMEOUT_MS=2000
PROVIDER_REQUEST_TIMEOUT_MS=10000
AI_REQUEST_TIMEOUT_MS=12000
PROVIDER_GATEWAY_REQUEST_TIMEOUT_MS=15000
PROVIDER_HEALTH_CHECK_TIMEOUT_MS=5000
PROVIDER_RETRY_BASE_DELAY_MS=100
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_MS=30000
PROVIDER_DEFAULT_MAX_ATTEMPTS=2
PROVIDER_WEBHOOK_CLAIM_BATCH_SIZE=25
PROVIDER_WEBHOOK_LEASE_SECONDS=120
PROVIDER_WEBHOOK_RETRY_BASE_SECONDS=15
PROVIDER_WEBHOOK_RETRY_MAXIMUM_SECONDS=3600
PROVIDER_WEBHOOK_RETRY_EXPONENT_CAP=7
PROVIDER_WEBHOOK_PROCESSED_RETENTION_DAYS=30
PROVIDER_WEBHOOK_PURGE_BATCH_SIZE=1000
API_PUBLIC_RATE_LIMIT=180
API_AUTHENTICATED_RATE_LIMIT=600
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_LOCK_SECONDS=60
# Optional comma-separated worker bulkheads: analytics, marketing, crm,
# communications, commercial, payments, finance, lifecycle. "all" runs every group.
WORKER_GROUPS=all
# Optional absolute path; native Make launchers use the checkout's .runtime/.
# Containers use their private writable /tmp when this is empty.
WORKER_HEALTH_FILE=
QUEUE_CONCURRENCY=4
SHUTDOWN_GRACE_MS=15000
# Derived from PUBLIC_FR_URL and PUBLIC_INTL_URL when empty.
CORS_ORIGIN=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RECENT_AUTH_SECONDS=600
OAUTH_FLOW_TTL_SECONDS=600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_BASE64=
PROVIDER_CREDENTIAL_KEY_VERSION=v1
# Dedicated backend-only AES-256-GCM key for paid links and credentials. Do not
# reuse provider, session, MFA, or signing keys and never expose this to clients.
DIGITAL_FULFILLMENT_ENCRYPTION_KEY_BASE64=
DIGITAL_FULFILLMENT_KEY_VERSION=v1
# Optional JSON object mapping retired key versions to 32-byte base64 keys
# during audited rotation. Remove an entry only after all envelopes are re-keyed.
DIGITAL_FULFILLMENT_PREVIOUS_KEYS_JSON=
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# Public, non-secret prefix containing owned copies of editorial/demo media.
PUBLIC_MEDIA_ASSET_BASE_URL=
# Storage image-transform capability for public media: "disabled" (default,
# originals are served unchanged) or "supabase_render" once the storage
# provider's image transformer is actually provisioned for this project.
# A rejected transform request is a broken photo, so this never defaults on.
PUBLIC_MEDIA_IMAGE_TRANSFORM=disabled
# Public category-card image prefix. Connected clients must use environment-owned
# Storage assets rather than the standalone demo application's local files.
PUBLIC_CATEGORY_MEDIA_BASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=demo
PAYMENT_MODE=test
EMAIL_MODE=console
EMAIL_RECIPIENT_ALLOWLIST=
AI_MODE=mock
ANALYTICS_MODE=off
# Server-side provider credentials. Keep these out of frontend environment
# files, image layers, logs, and Git values populated by deployments.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
GA4_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
MATOMO_ENABLED=false
MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_AUTH_TOKEN=
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SEARCH_CONSOLE_ENABLED=false
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
SEARCH_CONSOLE_SITE_URLS=
# Public discovery governance. Search/retrieval crawlers remain separate from
# model-training consent; verified-bot IP allowlisting is configured at the CDN.
SEO_GPTBOT_TRAINING_POLICY=deny
SEO_GOOGLE_SITE_VERIFICATION=
SEO_BING_SITE_VERIFICATION=
# Durable IndexNow delivery is backend-owned, production-only, and opt-in. The
# same server-side key is served at /indexnow-key.txt on canonical Web hosts.
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
# Shared server-side payment configuration for generic marketplace commerce and
# specialized verticals such as Shongre Immo. Never add these values to a
# NEXT_PUBLIC_* or VITE_* variable. Keep demo selected for standalone frontend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
COMPLIANCE_WEBHOOK_SECRET=
HANDOVER_PIN_PEPPER=
KYC_PROVIDER=demo
# Generic live KYC/OTP gateway settings. Keep KYC_PROVIDER=demo locally; a
# production release gate requires a non-demo provider and these server-only
# credentials when KYC_PROVIDER=live.
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_TOKEN=
BUSINESS_REGISTRY_PROVIDER=demo
BUSINESS_REGISTRY_API_URL=https://api.insee.fr/api-sirene/3.11
BUSINESS_REGISTRY_API_TOKEN=
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=
MALWARE_SCAN_MODE=disabled
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
MALWARE_SCAN_TIMEOUT_MS=15000
DEMO_ACCOUNT_PASSWORD=

# Restricted release evidence. Leave empty outside a release-candidate
# operation; production approval requires all files and the exact RELEASE_SHA.
BACKUP_RESTORE_EVIDENCE_FILE=
PROVIDER_SMOKE_EVIDENCE_FILE=
RELEASE_APPROVAL_EVIDENCE_FILE=
STAGING_CERTIFICATION_EVIDENCE_FILE=
OBSERVABILITY_EVIDENCE_FILE=
EDGE_FUNCTION_INVENTORY_EVIDENCE_FILE=

# Provider Platform note: these values configure platform-owned legacy/runtime
# adapters only. Never place a tenant or user's CRM mailbox token, OAuth refresh
# token, BYOK/BYOP key, SMTP password, or provider connection credential in an
# environment variable. Tenant/user secrets are installed through the
# server-side Provider Platform credential store and are never NEXT_PUBLIC_/VITE_*.

# Authentication delivery and provider rollout. All client secrets and the
# Apple signing key are server-only: never prefix them NEXT_PUBLIC_ or VITE_.
ENABLE_EMAIL_PASSWORD_AUTH=true
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=
# Transactional notification email. SMTP is used rather than one vendor's REST
# API so an approved provider (Brevo, Mailgun, SES, Postmark, ...) is selected
# by credentials alone. Required in production: a deployment that cannot send
# email cannot confirm an address, reset a password or acknowledge an order.
NOTIFICATION_SMTP_URL=
NOTIFICATION_EMAIL_FROM=
# Push delivery. "expo" matches the token the mobile client registers; talking
# to APNs/FCM directly would mean holding two more sets of platform
# credentials to reach the same devices. Required in production.
PUSH_PROVIDER=disabled
EXPO_PUSH_ACCESS_TOKEN=
# Bearer token guarding GET /metrics, which serves the Prometheus series behind
# the availability and latency objectives in infrastructure/monitoring. Without
# it the endpoint answers 404 rather than advertising itself; production refuses
# to start without one of at least 24 characters.
METRICS_TOKEN=
# Local auth email is delivered only to Supabase's Mailpit sink. Compose
# overrides the host while preserving this port from the canonical profile.
LOCAL_MAIL_SMTP_URL=smtp://127.0.0.1:54326
ENABLE_SOCIAL_AUTH=false
ENABLE_ACCOUNT_LINKING=false
ENABLE_GOOGLE_AUTH=false
ENABLE_APPLE_AUTH=false
ENABLE_FACEBOOK_AUTH=false
OAUTH_ALLOWED_RETURN_ORIGINS=
MOBILE_AUTH_CALLBACK_URL=shongre://auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_AUTHORIZATION_URL=https://www.facebook.com/dialog/oauth
# Pin the Graph API version supported by the configured Facebook app.
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com/vXX.X

# Expo application runtime. Public values are bundled and must never be secret.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_ENVIRONMENT_ID=shongre-local
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
EXPO_PUBLIC_FR_URL=http://127.0.0.1:3000
EXPO_PUBLIC_INTL_URL=http://127.0.0.1:3000

# Stable mobile identifiers and versions. Confirm ownership before first store
# release; do not change identifiers after publication.
IOS_BUNDLE_IDENTIFIER=com.shongre.marketplace
ANDROID_PACKAGE_NAME=com.shongre.marketplace
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINT=
EAS_PROJECT_ID=

# Production mobile checks consume the same PUBLIC_FR_URL, PUBLIC_INTL_URL and
# API_URL values as Web/backend. No second set of production hostnames exists.

# Geospatial: map rendering, geocoding and location privacy.
#
# These names are shared by the backend, the Web client and the Expo client on
# purpose. There is deliberately no NEXT_PUBLIC_ or EXPO_PUBLIC_ copy: one set
# of names is what stops the three clients drifting onto different providers,
# which is the state this configuration replaced.
#
# MapLibre is the renderer on every platform. OpenFreeMap supplies the initial
# vector style and needs no key; OpenStreetMap supplies the underlying data, and
# MAP_ATTRIBUTION is a condition of that licence rather than a caption.
MAP_PROVIDER=openfreemap
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=
# The opening view before a market narrows it. France's approximate centroid.
MAP_DEFAULT_LATITUDE=46.6
MAP_DEFAULT_LONGITUDE=2.4
MAP_DEFAULT_ZOOM=6
MAP_MIN_ZOOM=3
MAP_MAX_ZOOM=19

# Address resolution runs server-side only; a browser never reaches the
# provider. `nominatim` here means "a Nominatim-compatible endpoint" — the
# public openstreetmap.org instance is suitable for local development and
# explicitly not for production traffic, so a hosted environment must name a
# self-hosted or managed endpoint. Leave GEOCODING_PROVIDER empty outside local
# and test and address autocomplete stays off rather than silently abusing a
# shared service.
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Shongre/1.0 (marketplace geocoding)
# Required outside local and test: the provider's usage policy identifies the
# operator through it, and an anonymous automated client may be blocked.
GEOCODING_CONTACT_EMAIL=
# Upstream requests per minute, platform-wide.
GEOCODING_RATE_LIMIT=60
# Seconds. An address does not move, so this is deliberately long.
GEOCODING_CACHE_TTL=2592000
GEOCODING_TIMEOUT_MS=5000
GEOCODING_MAX_RETRIES=2
GEOCODING_MAX_RESULTS=8

# Location privacy. A public listing point is displaced by a deterministic
# offset within this radius, so repeated requests cannot average back to the
# seller's real position. `exact` is refused as a default: a private seller's
# doorstep is not a public fact.
LOCATION_PRIVACY_RADIUS_METERS=1000
LOCATION_DEFAULT_PUBLIC_PRECISION=approximate
# The largest radius a "near me" search may ask for. Past this the filter stops
# being selective and the query stops being cheap.
LOCATION_SEARCH_MAX_RADIUS_KM=200
