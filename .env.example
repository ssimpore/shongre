# Shongre local orchestration. Copy with `make env-init` and keep secrets in
# .env.local or package-specific .env.local files.
APP_ENV=development

# Application hosts and host ports. These values are the single local source
# of truth; change them here rather than editing Makefile or package scripts.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
EXPO_HOST=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_WEB_PORT=8082
STORYBOOK_PORT=6006

# Supabase host ports. Container-internal ports remain owned by Supabase.
SUPABASE_HOST=127.0.0.1
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_SHADOW_PORT=54320
SUPABASE_REALTIME_PORT=54323
SUPABASE_STUDIO_PORT=54324
SUPABASE_INBUCKET_PORT=54325
SUPABASE_SMTP_PORT=54326
SUPABASE_POP3_PORT=54327
SUPABASE_POOLER_PORT=54329

# Web runtime. Next.js variables are canonical; VITE_* aliases remain during
# the incremental router migration and are derived by scripts/env.sh.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Shongre
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=FR
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_LOCALE=fr-FR
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=true
VITE_DATA_MODE=demo
VITE_API_URL=
VITE_APP_NAME=Shongre
VITE_APP_URL=
VITE_DEFAULT_COUNTRY_CODE=FR
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=fr-FR
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_MOCK_STORAGE=true

# Backend runtime. Secrets intentionally have no example value.
API_PREFIX=/api/v1
BACKEND_DATA_MODE=demo
CORS_ORIGIN=
AUTH_TOKEN_TTL_SECONDS=43200
JWT_SECRET=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=demo
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KYC_PROVIDER=demo
BUSINESS_REGISTRY_PROVIDER=demo
AI_PROVIDER=demo
GEMINI_API_KEY=
DEMO_ACCOUNT_PASSWORD=

# Expo application runtime. Public values are bundled and must never be secret.
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=

# Stable mobile identifiers and versions. Confirm ownership before first store
# release; do not change identifiers after publication.
IOS_BUNDLE_IDENTIFIER=com.shongre.marketplace
ANDROID_PACKAGE_NAME=com.shongre.marketplace
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINT=
EAS_PROJECT_ID=

# Production URLs are required by `make mobile-production-env-check` and must be
# HTTPS endpoints with no loopback, emulator, LAN, or temporary tunnel host.
PRODUCTION_API_URL=https://api.shongre.com/api/v1
PRODUCTION_WEB_URL=https://shongre.com
PRODUCTION_PRIVACY_URL=https://shongre.com/privacy
PRODUCTION_TERMS_URL=https://shongre.com/terms
PRODUCTION_SUPPORT_URL=https://shongre.com/support
PRODUCTION_ACCOUNT_DELETION_URL=https://shongre.com/account/delete
