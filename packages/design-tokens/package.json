{
  "name": "@shongre/design-tokens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./native": "./src/native.ts",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "check:generated": "node scripts/build-css.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
