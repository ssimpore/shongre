{
  "name": "@shongre/brand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./document": "./src/document.generated.ts",
    "./web": "./src/web-assets.generated.ts"
  },
  "scripts": {
    "assets": "node --import tsx ../../scripts/sync-brand-assets.ts",
    "check:assets": "node --import tsx ../../scripts/check-brand-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "check": "npm run check:assets && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@shongre/design-tokens": "1.0.0"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
