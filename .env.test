# Deterministic isolated test profile. CI may override ports and database URLs.
APP_ENV=test
ENVIRONMENT_ID=shongre-test
API_ENVIRONMENT_ID=shongre-test
DATABASE_ENVIRONMENT_ID=shongre-test
SUPABASE_ENVIRONMENT_ID=shongre-test
STORAGE_ENVIRONMENT_ID=shongre-test
NODE_ENV=test
PUBLIC_FR_URL=http://127.0.0.1:3000
PUBLIC_INTL_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
E2E_FRONTEND_PORT=3110
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
EXPO_HOST=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_WEB_PORT=8082
STORYBOOK_PORT=6006
SUPABASE_HOST=127.0.0.1
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_SHADOW_PORT=54320
SUPABASE_REALTIME_PORT=54323
SUPABASE_STUDIO_PORT=54324
SUPABASE_INBUCKET_PORT=54325
SUPABASE_SMTP_PORT=54326
SUPABASE_POP3_PORT=54327
SUPABASE_POOLER_PORT=54329

API_PREFIX=/api/v1
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_APP_NAME=Shongre
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=true
SHONGRE_TRUST_PROXY_HOST=false
SHONGRE_TRUST_PROXY_IP=false
SHONGRE_ALLOWED_DEV_ORIGINS=
BACKEND_DATA_MODE=demo
DATABASE_INFRA_MODE=local
CORS_ORIGIN=http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000
PAYMENT_MODE=test
PAYMENT_PROVIDER=demo
EMAIL_MODE=console
AI_MODE=mock
ANALYTICS_MODE=test
KYC_PROVIDER=demo
BUSINESS_REGISTRY_PROVIDER=demo
AI_PROVIDER=demo
ENABLE_EMAIL_PASSWORD_AUTH=true
ENABLE_SOCIAL_AUTH=false
ENABLE_ACCOUNT_LINKING=false
ENABLE_GOOGLE_AUTH=false
ENABLE_APPLE_AUTH=false
ENABLE_FACEBOOK_AUTH=false
OAUTH_ALLOWED_RETURN_ORIGINS=
MOBILE_AUTH_CALLBACK_URL=shongre://auth/callback
EXPO_PUBLIC_DATA_MODE=demo
IOS_BUNDLE_IDENTIFIER=com.shongre.marketplace.test
ANDROID_PACKAGE_NAME=com.shongre.marketplace.test
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
