# Commit-safe production deployment configuration. Credentials belong only in
# the deployment secret manager or ignored .env.production.local.
APP_ENV=production
ENVIRONMENT_ID=shongre-production
API_ENVIRONMENT_ID=shongre-production
DATABASE_ENVIRONMENT_ID=shongre-production
SUPABASE_ENVIRONMENT_ID=shongre-production
STORAGE_ENVIRONMENT_ID=shongre-production
NODE_ENV=production

PUBLIC_FR_URL=https://shongre.fr
PUBLIC_INTL_URL=https://shongre.com
API_URL=https://api.shongre.fr
SHONGRE_MARKETPLACE_ORIGIN=
SHONGRE_SOLUTIONS_ORIGIN=
SHONGRE_PROSPECTS_ORIGIN=
SHONGRE_FACTURATION_ORIGIN=

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
E2E_FRONTEND_PORT=3110
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
EXPO_HOST=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_WEB_PORT=8082
STORYBOOK_PORT=6006
SUPABASE_HOST=127.0.0.1
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_SHADOW_PORT=54320
SUPABASE_REALTIME_PORT=54323
SUPABASE_STUDIO_PORT=54324
SUPABASE_INBUCKET_PORT=54325
SUPABASE_SMTP_PORT=54326
SUPABASE_POP3_PORT=54327
SUPABASE_POOLER_PORT=54329

API_PREFIX=/api/v1
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_INTERNAL_ANALYTICS_ENABLED=true
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY_ENABLED=false
NEXT_PUBLIC_GA4_ENABLED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_MATOMO_ENABLED=false
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_SITE_TAG=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_APP_NAME=Shongre
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SHONGRE_TRUST_PROXY_HOST=true
SHONGRE_TRUST_PROXY_IP=true
SHONGRE_ALLOWED_DEV_ORIGINS=

BACKEND_DATA_MODE=database
DATABASE_INFRA_MODE=hosted
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000
CORS_ORIGIN=https://shongre.fr,https://shongre.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=

DATABASE_URL=
SUPABASE_PROJECT_REF=
EXPECTED_SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
HANDOVER_PIN_PEPPER=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_BASE64=
PROVIDER_CREDENTIAL_KEY_VERSION=production-v1
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=

PAYMENT_MODE=live
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
COMPLIANCE_WEBHOOK_SECRET=
EMAIL_MODE=live
EMAIL_RECIPIENT_ALLOWLIST=
