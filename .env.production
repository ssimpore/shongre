# Safe, commit-ready production defaults. Production credentials belong in the
# deployment secret store or an ignored .env.production.local file.
APP_ENV=production
NODE_ENV=production

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
E2E_FRONTEND_PORT=3110
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
EXPO_HOST=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_WEB_PORT=8082
STORYBOOK_PORT=6006

# Required by common tooling; hosted mode never starts the local ports.
SUPABASE_HOST=127.0.0.1
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_SHADOW_PORT=54320
SUPABASE_REALTIME_PORT=54323
SUPABASE_STUDIO_PORT=54324
SUPABASE_INBUCKET_PORT=54325
SUPABASE_SMTP_PORT=54326
SUPABASE_POP3_PORT=54327
SUPABASE_POOLER_PORT=54329

NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_URL=https://api.shongre.com/api/v1
NEXT_PUBLIC_APP_NAME=Shongre
NEXT_PUBLIC_APP_URL=https://shongre.fr
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=FR
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_LOCALE=fr-FR
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=false
NEXT_PUBLIC_SHONGRE_GLOBAL_DOMAIN=shongre.com
NEXT_PUBLIC_SHONGRE_FR_DOMAIN=shongre.fr
NEXT_PUBLIC_SHONGRE_CANONICAL_PROTOCOL=https
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

VITE_DATA_MODE=api
VITE_API_URL=https://api.shongre.com/api/v1
VITE_APP_NAME=Shongre
VITE_APP_URL=https://shongre.fr
VITE_DEFAULT_COUNTRY_CODE=FR
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=fr-FR
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_MOCK_STORAGE=false

SHONGRE_GLOBAL_DOMAIN=shongre.com
SHONGRE_FR_DOMAIN=shongre.fr
SHONGRE_CANONICAL_PROTOCOL=https
# Enable only after verifying the production proxy overwrites Host forwarding.
SHONGRE_TRUST_PROXY_HOST=false
SHONGRE_ALLOWED_DEV_ORIGINS=

API_PREFIX=/api/v1
BACKEND_DATA_MODE=database
DATABASE_INFRA_MODE=hosted
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000
FRONTEND_URL=https://shongre.fr
PUBLIC_API_URL=https://api.shongre.com
CORS_ORIGIN=https://shongre.fr,https://shongre.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=api.shongre.com

# Required deployment secrets. Do not commit values here.
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
HANDOVER_PIN_PEPPER=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_BASE64=
PROVIDER_CREDENTIAL_KEY_VERSION=production-v1
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
COMPLIANCE_WEBHOOK_SECRET=
KYC_PROVIDER=stripe
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_TOKEN=
BUSINESS_REGISTRY_PROVIDER=siret
BUSINESS_REGISTRY_API_URL=https://api.insee.fr/api-sirene/3.11
BUSINESS_REGISTRY_API_TOKEN=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
DEMO_ACCOUNT_PASSWORD=

ENABLE_EMAIL_PASSWORD_AUTH=true
ENABLE_SOCIAL_AUTH=false
ENABLE_ACCOUNT_LINKING=false
ENABLE_GOOGLE_AUTH=false
ENABLE_APPLE_AUTH=false
ENABLE_FACEBOOK_AUTH=false
OAUTH_ALLOWED_RETURN_ORIGINS=https://shongre.fr,https://shongre.com
MOBILE_AUTH_CALLBACK_URL=shongre://auth/callback
GOOGLE_OAUTH_CALLBACK_URL=https://api.shongre.com/api/v1/auth/oauth/google/callback
APPLE_OAUTH_CALLBACK_URL=https://api.shongre.com/api/v1/auth/oauth/apple/callback
FACEBOOK_OAUTH_CALLBACK_URL=https://api.shongre.com/api/v1/auth/oauth/facebook/callback

EXPO_PUBLIC_DATA_MODE=api
EXPO_PUBLIC_API_URL=https://api.shongre.com/api/v1
EXPO_PUBLIC_WEB_URL=https://shongre.com
EXPO_PUBLIC_FRANCE_WEB_URL=https://shongre.fr
EXPO_PUBLIC_GLOBAL_WEB_URL=https://shongre.com
EXPO_PUBLIC_PRIVACY_URL=https://shongre.com/privacy
EXPO_PUBLIC_TERMS_URL=https://shongre.com/terms
EXPO_PUBLIC_SUPPORT_URL=https://shongre.com/support
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://shongre.com/account/delete

IOS_BUNDLE_IDENTIFIER=com.shongre.marketplace
ANDROID_PACKAGE_NAME=com.shongre.marketplace
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1

PRODUCTION_API_URL=https://api.shongre.com/api/v1
PRODUCTION_WEB_URL=https://shongre.com
PRODUCTION_PRIVACY_URL=https://shongre.com/privacy
PRODUCTION_TERMS_URL=https://shongre.com/terms
PRODUCTION_SUPPORT_URL=https://shongre.com/support
PRODUCTION_ACCOUNT_DELETION_URL=https://shongre.com/account/delete
