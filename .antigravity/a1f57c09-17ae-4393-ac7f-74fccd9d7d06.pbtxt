    content: "@import \"tailwindcss\";\n\n/* =============================================================================\n   Shongre Design Tokens \342\200\224 canonical source of visual truth.\n   Mirrored in TypeScript by src/design-system/tokens/* (kept in sync by\n   design-system/tokens/tokens.parity.test.ts). Change values here first.\n   ============================================================================= */\n@theme {\n  /* --- Brand -------------------------------------------------------------\n     The terracotta ramp is tuned so the brand clears WCAG AA (4.5:1) in both\n     directions on every surface it actually appears on:\n       #C4431F  5.04:1 vs white  \302\267  4.75:1 vs bg-base  \302\267  4.63:1 vs primary-light\n     The previous #D9532F sat at 4.02:1 / 3.79:1 / 3.69:1, so both white-on-primary\n     buttons and primary-on-light text were below the threshold. Hover and active\n     keep ~1.4x luminance steps so the states stay perceptible.\n     `primary-on-dark` is the inverse-surface variant: the light-surface ramp is\n     too dark to read on stone-900 panels. */\n  --color-primary: #C4431F;\n  --color-primary-hover: #AB3919;\n  --color-primary-active: #932F13;\n  --color-primary-light: #FFF3EF;\n  --color-primary-border: #FED7CC;\n  --color-primary-on-dark: #F0785A;\n\n  /* --- Surfaces & borders ------------------------------------------------- */\n  --color-bg-base: #FAF8F5;\n  --color-bg-surface: #FFFFFF;\n  --color-bg-subtle: #F4F1EA;\n  --color-bg-muted: #EAE6DD;\n  --color-border-base: #E8E4DC;\n  --color-border-subtle: #F0ECE4;\n  --color-border-hover: #D6D0C5;\n\n  /* --- Text -------------------------------------------------------------- */\n  --color-text-main: #1C1917;\n  --color-text-secondary: #57534E;\n  --color-text-muted: #78716C;\n  --color-stone-900: #1C1917;\n\n  /* `stone-500` is the platform\'s secondary-text weight (the codebase uses the\n     stone-* vocabulary rather than the semantic aliases above). Tailwind\'s own\n     #79716B only reaches 4.24:1 on bg-subtle and 4.40:1 on primary-light, so it\n     failed AA on the tinted surfaces Shongre actually uses. This is the smallest\n     darkening that clears 4.5:1 on white, bg-base, bg-subtle and primary-light. */\n  --color-stone-500: #736C66;\n\n  /* --- Semantic status ---------------------------------------------------\n     Use these instead of reaching into raw emerald/amber/red/sky palettes so\n     the same state always reads the same way across cards, tables and admin. */\n  --color-success: #15803D;\n  --color-success-surface: #F0FDF4;\n  --color-success-border: #BBF7D0;\n  --color-warning: #B45309;\n  --color-warning-surface: #FFFBEB;\n  --color-warning-border: #FDE68A;\n  --color-danger: #B91C1C;\n  --color-danger-surface: #FEF2F2;\n  --color-danger-border: #FECACA;\n  --color-info: #0369A1;\n  --color-info-surface: #F0F9FF;\n  --color-info-border: #BAE6FD;\n\n  /* --- Radius scale -------------------------------------------------------\n     Tuned so the shared classes already in use land on the right semantics:\n       rounded-lg  (8px)  \342\206\222 chips, inline tags, small surfaces\n       rounded-xl  (10px) \342\206\222 buttons, inputs, icon buttons  (control radius)\n       rounded-2xl (14px) \342\206\222 cards, panels                  (card radius)\n       rounded-3xl (18px) \342\206\222 modals, drawers, hero surfaces (overlay radius)\n     Keeping the scale here means radius is harmonised platform-wide instead of\n     component by component. */\n  --radius-xs: 0.125rem;  /* 2px  */\n  --radius-sm: 0.25rem;   /* 4px  */\n  --radius-md: 0.375rem;  /* 6px  */\n  --radius-lg: 0.5rem;    /* 8px  */\n  --radius-xl: 0.625rem;  /* 10px \342\200\224 control */\n  --radius-2xl: 0.875rem; /* 14px \342\200\224 card    */\n  --radius-3xl: 1.125rem; /* 18px \342\200\224 overlay */\n  --radius-pill: 9999px;\n\n  /* --- Typography ---------------------------------------------------------\n     `micro` is the smallest size allowed anywhere in the product. It exists for\n     badges, counters and dense metadata only \342\200\224 never for body copy. Anything\n     that needs to be read in a sentence starts at `xs`. */\n  --text-micro: 0.6875rem; /* 11px */\n  --text-micro--line-height: 1.35;\n\n  /* --- Control metrics ----------------------------------------------------\n     Shared heights for buttons, inputs, selects and icon buttons so a form row\n     never mixes 36/38/40px controls. */\n  --spacing-control-sm: 2rem;   /* 32px */\n  --spacing-control-md: 2.5rem; /* 40px */\n  --spacing-control-lg: 3rem;   /* 48px */\n\n  /* --- Layout containers -------------------------------------------------- */\n  --container-content: 72rem;   /* 1152px \342\200\224 consumer reading width */\n  --container-page: 80rem;      /* 1280px \342\200\224 standard page shell    */\n  --container-workspace: 96rem; /* 1536px \342\200\224 dense admin / CRM      */\n\n  /* --- Motion -------------------------------------------------------------\n     Centralised so components stop inventing their own durations. */"
    raw_content: "@import \"tailwindcss\";\n\n/* =============================================================================\n   Shongre Design Tokens \342\200\224 canonical source of visual truth.\n   Mirrored in TypeScript by src/design-system/tokens/* (kept in sync by\n   design-system/tokens/tokens.parity.test.ts). Change values here first.\n   ============================================================================= */\n@theme {\n  /* --- Brand -------------------------------------------------------------\n     The terracotta ramp is tuned so the brand clears WCAG AA (4.5:1) in both\n     directions on every surface it actually appears on:\n       #C4431F  5.04:1 vs white  \302\267  4.75:1 vs bg-base  \302\267  4.63:1 vs primary-light\n     The previous #D9532F sat at 4.02:1 / 3.79:1 / 3.69:1, so both white-on-primary\n     buttons and primary-on-light text were below the threshold. Hover and active\n     keep ~1.4x luminance steps so the states stay perceptible.\n     `primary-on-dark` is the inverse-surface variant: the light-surface ramp is\n     too dark to read on stone-900 panels. */\n  --color-primary: #C4431F;\n  --color-primary-hover: #AB3919;\n  --color-primary-active: #932F13;\n  --color-primary-light: #FFF3EF;\n  --color-primary-border: #FED7CC;\n  --color-primary-on-dark: #F0785A;\n\n  /* --- Surfaces & borders ------------------------------------------------- */\n  --color-bg-base: #FAF8F5;\n  --color-bg-surface: #FFFFFF;\n  --color-bg-subtle: #F4F1EA;\n  --color-bg-muted: #EAE6DD;\n  --color-border-base: #E8E4DC;\n  --color-border-subtle: #F0ECE4;\n  --color-border-hover: #D6D0C5;\n\n  /* --- Text -------------------------------------------------------------- */\n  --color-text-main: #1C1917;\n  --color-text-secondary: #57534E;\n  --color-text-muted: #78716C;\n  --color-stone-900: #1C1917;\n\n  /* `stone-500` is the platform\'s secondary-text weight (the codebase uses the\n     stone-* vocabulary rather than the semantic aliases above). Tailwind\'s own\n     #79716B only reaches 4.24:1 on bg-subtle and 4.40:1 on primary-light, so it\n     failed AA on the tinted surfaces Shongre actually uses. This is the smallest\n     darkening that clears 4.5:1 on white, bg-base, bg-subtle and primary-light. */\n  --color-stone-500: #736C66;\n\n  /* --- Semantic status ---------------------------------------------------\n     Use these instead of reaching into raw emerald/amber/red/sky palettes so\n     the same state always reads the same way across cards, tables and admin. */\n  --color-success: #15803D;\n  --color-success-surface: #F0FDF4;\n  --color-success-border: #BBF7D0;\n  --color-warning: #B45309;\n  --color-warning-surface: #FFFBEB;\n  --color-warning-border: #FDE68A;\n  --color-danger: #B91C1C;\n  --color-danger-surface: #FEF2F2;\n  --color-danger-border: #FECACA;\n  --color-info: #0369A1;\n  --color-info-surface: #F0F9FF;\n  --color-info-border: #BAE6FD;\n\n  /* --- Radius scale -------------------------------------------------------\n     Tuned so the shared classes already in use land on the right semantics:\n       rounded-lg  (8px)  \342\206\222 chips, inline tags, small surfaces\n       rounded-xl  (10px) \342\206\222 buttons, inputs, icon buttons  (control radius)\n       rounded-2xl (14px) \342\206\222 cards, panels                  (card radius)\n       rounded-3xl (18px) \342\206\222 modals, drawers, hero surfaces (overlay radius)\n     Keeping the scale here means radius is harmonised platform-wide instead of\n     component by component. */\n  --radius-xs: 0.125rem;  /* 2px  */\n  --radius-sm: 0.25rem;   /* 4px  */\n  --radius-md: 0.375rem;  /* 6px  */\n  --radius-lg: 0.5rem;    /* 8px  */\n  --radius-xl: 0.625rem;  /* 10px \342\200\224 control */\n  --radius-2xl: 0.875rem; /* 14px \342\200\224 card    */\n  --radius-3xl: 1.125rem; /* 18px \342\200\224 overlay */\n  --radius-pill: 9999px;\n\n  /* --- Typography ---------------------------------------------------------\n     `micro` is the smallest size allowed anywhere in the product. It exists for\n     badges, counters and dense metadata only \342\200\224 never for body copy. Anything\n     that needs to be read in a sentence starts at `xs`. */\n  --text-micro: 0.6875rem; /* 11px */\n  --text-micro--line-height: 1.35;\n\n  /* --- Control metrics ----------------------------------------------------\n     Shared heights for buttons, inputs, selects and icon buttons so a form row\n     never mixes 36/38/40px controls. */\n  --spacing-control-sm: 2rem;   /* 32px */\n  --spacing-control-md: 2.5rem; /* 40px */\n  --spacing-control-lg: 3rem;   /* 48px */\n\n  /* --- Layout containers -------------------------------------------------- */\n  --container-content: 72rem;   /* 1152px \342\200\224 consumer reading width */\n  --container-page: 80rem;      /* 1280px \342\200\224 standard page shell    */\n  --container-workspace: 96rem; /* 1536px \342\200\224 dense admin / CRM      */\n\n  /* --- Motion -------------------------------------------------------------\n     Centralised so components stop inventing their own durations. */\n  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-out-soft: cubic-bezier(0.16, 1, 0.3, 1);\n  --duration-fast: 150ms;\n  --duration-normal: 250ms;\n  --duration-slow: 350ms;\n}\n\n@layer base {\n  html, body {\n    height: 100%;\n    width: 100%;\n  }\n\n  body {\n    background-color: var(--color-bg-base);\n    color: var(--color-text-main);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    min-height: 100vh;\n    overflow-x: hidden;\n  }\n\n  /* Focus visible accessibility outline */\n  *:focus-visible {\n    outline: 2px solid var(--color-primary);\n    outline-offset: 2px;\n  }\n\n  /* Global prefers-reduced-motion compliance */\n  @media (prefers-reduced-motion: reduce) {\n    *, ::before, ::after {\n      animation-duration: 0.01ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: 0.01ms !important;\n      scroll-behavior: auto !important;\n    }\n  }\n}\n\n/* =============================================================================\n   Entrance animation utilities\n   Menus, modals and drawers across the app already use this vocabulary\n   (`animate-in fade-in zoom-in-95`, `slide-in-from-right`\342\200\246). Defining it here\n   keeps the motion language in one place and avoids a new dependency.\n   ============================================================================= */\n@layer utilities {\n  @keyframes shongre-enter {\n    from {\n      opacity: var(--enter-opacity, 1);\n      transform: translate3d(var(--enter-x, 0), var(--enter-y, 0), 0) scale(var(--enter-scale, 1));\n    }\n  }\n\n  .animate-in {\n    animation-name: shongre-enter;\n    animation-duration: var(--duration-fast);\n    animation-timing-function: var(--ease-out-soft);\n    animation-fill-mode: both;\n  }\n\n  .fade-in { --enter-opacity: 0; }\n\n  /* Standalone fade for elements that appear without a companion transform\n     (lightbox backdrop, notification badge, timeline status pills). */\n  @keyframes shongre-fade-in {\n    from { opacity: 0; }\n    to { opacity: 1; }\n  }\n  .animate-fade-in {\n    animation: shongre-fade-in var(--duration-normal) var(--ease-out-soft) both;\n  }\n\n  .zoom-in-95 { --enter-scale: 0.95; }\n  .slide-in-from-top { --enter-y: -0.5rem; }\n  .slide-in-from-bottom { --enter-y: 0.5rem; }\n  .slide-in-from-left { --enter-x: -0.5rem; }\n  .slide-in-from-right { --enter-x: 100%; }\n\n  /* Horizontal rails (filter chips, tab strips, category rows) scroll without\n     showing a scrollbar \342\200\224 the affordance is the content bleeding off-edge. */\n  .no-scrollbar {\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n\n  /* Safe-area helpers for iOS / future app wrappers. */\n  .pb-safe { padding-bottom: env(safe-area-inset-bottom); }\n  .pt-safe { padding-top: env(safe-area-inset-top); }\n}\n\n/* Smooth Infinite Marquee Animations */\n@keyframes vertical-scroll-up {\n  0% {\n    transform: translateY(0);\n  }\n  100% {\n    transform: translateY(-50%);\n  }\n}\n\n@keyframes vertical-scroll-down {\n  0% {\n    transform: translateY(-50%);\n  }\n  100% {\n    transform: translateY(0);\n  }\n}\n\n@keyframes horizontal-scroll-left {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n\n.animate-marquee-vertical-up {\n  animation: vertical-scroll-up 28s linear infinite;\n}\n\n.animate-marquee-vertical-up-slow {\n  animation: vertical-scroll-up 38s linear infinite;\n}\n\n.animate-marquee-vertical-down {\n  animation: vertical-scroll-down 32s linear infinite;\n}\n\n.animate-marquee-horizontal {\n  animation: horizontal-scroll-left 24s linear infinite;\n}\n\n.pause-animation {\n  animation-play-state: paused !important;\n}\n\n.hover-pause:hover .animate-marquee-vertical-up,\n.hover-pause:hover .animate-marquee-vertical-up-slow,\n.hover-pause:hover .animate-marquee-vertical-down,\n.hover-pause:hover .animate-marquee-horizontal {\n  animation-play-state: paused;\n}\n\n/* =============================================================================\n   Touch-device form controls\n   iOS Safari zooms the whole page when a focused control renders below 16px, and\n   every control in the app was 12\342\200\22314px \342\200\224 so tapping any field on an iPhone\n   jumped the layout and the user had to pinch back out. Desktop keeps its\n   compact density: this only applies to coarse pointers.\n\n   Deliberately unlayered. `@import \"tailwindcss\"` puts utilities in a cascade\n   layer, and unlayered rules win over layered ones, so this overrides `text-sm`\n   / `text-xs` on controls without resorting to `!important`.\n   ============================================================================= */\n@media (pointer: coarse) {\n  input:not([type=\'checkbox\']):not([type=\'radio\']):not([type=\'range\']),\n  textarea,\n  select {\n    font-size: 1rem;\n    line-height: 1.4;\n  }\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: #D6D3CD;\n  border-radius: var(--radius-pill);\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #A8A29E;\n}\n"
    num_lines: 285
    num_bytes: 10023
  }
}
