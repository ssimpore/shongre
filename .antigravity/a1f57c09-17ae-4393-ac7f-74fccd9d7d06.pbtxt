      replacement_content: "      {/* Multi-Market Distribution Modal */}\n      {marketsModalListing && (\n        <Modal\n          isOpen={true}\n          onClose={() => setMarketsModalListing(null)}\n          title=\"March\303\251s de diffusion de l\'annonce\"\n          description={`G\303\251rer les pays o\303\271 \"${marketsModalListing.title}\" est visible`}\n        >\n          <div className=\"space-y-4 text-xs\">\n            <p className=\"text-stone-600\">\n              S\303\251lectionnez les march\303\251s nationaux sur lesquels vous souhaitez diffuser cette annonce. Le march\303\251 d\'origine ({marketsModalListing.marketCode || \'FR\'}) est obligatoire.\n            </p>\n\n            <div className=\"space-y-2.5\">\n              {marketService.getMarkets().map((m) => {\n                const isSelected = selectedMarketsInModal.includes(m.code);\n                const isPrimary = (marketsModalListing.marketCode || \'FR\') === m.code;\n                const isCatEnabled = marketService.isCategoryEnabledInMarket(\n                  m.code,\n                  marketsModalListing.categorySlug\n                );\n\n                return (\n                  <div\n                    key={m.code}\n                    onClick={() => {\n                      if (!isCatEnabled && !isSelected) {\n                        toast.error(\n                          `La cat\303\251gorie \"${marketsModalListing.categoryLabel || marketsModalListing.categorySlug}\" n\'est pas ouverte sur ${m.name}.`\n                        );\n                        return;\n                      }\n                      if (isPrimary && isSelected) {\n                        toast.info(\'Le march\303\251 d\\\'origine de l\\\'annonce ne peut pas \303\252tre retir\303\251.\');\n                        return;\n                      }\n                      const next = isSelected\n                        ? selectedMarketsInModal.filter((c) => c !== m.code)\n                        : [...selectedMarketsInModal, m.code];\n                      setSelectedMarketsInModal(next.length === 0 ? [\'FR\'] : next);\n                    }}\n                    className={`p-3.5 rounded-xl border transition-all cursor-pointer flex items-center justify-between ${\n                      isSelected\n                        ? \'border-primary bg-primary-light/40 ring-1 ring-primary\'\n                        : isCatEnabled\n                        ? \'border-border-base bg-white hover:bg-stone-50\'\n                        : \'border-stone-200 bg-stone-50 opacity-60 cursor-not-allowed\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"text-2xl\">{m.flag}</span>\n                      <div>\n                        <div className=\"font-bold text-stone-900 flex items-center gap-1.5\">\n                          {m.name} ({m.code})\n                          {isPrimary && (\n                            <span className=\"text-micro bg-primary text-white font-bold px-1.5 py-0.2 rounded-full\">\n                              Origine\n                            </span>\n                          )}\n                        </div>\n                        <div className=\"text-micro text-stone-500\">\n                          Devise : {m.currency} ({m.currencySymbol})\n                          {!isCatEnabled && \' \342\200\242 Cat\303\251gorie non disponible\'}\n                        </div>\n                      </div>\n                    </div>\n\n                    <input\n                      type=\"checkbox\"\n                      checked={isSelected}\n                      disabled={!isCatEnabled || isPrimary}\n                      onChange={() => {}}\n                      className=\"h-4 w-4 rounded border-stone-300 text-primary focus:ring-primary cursor-pointer\"\n                    />\n                  </div>\n                );\n              })}\n            </div>\n\n            <div className=\"flex justify-end gap-2 pt-3 border-t border-border-subtle\">\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={() => setMarketsModalListing(null)}\n              >\n                Annuler\n              </Button>\n              <Button\n                variant=\"primary\"\n                size=\"sm\"\n                onClick={async () => {\n                  if (marketsModalListing) {\n                    await listingRepository.updateListingMarkets(\n                      marketsModalListing.id,\n                      selectedMarketsInModal\n                    );\n                    toast.success(\'March\303\251s de diffusion mis \303\240 jour avec succ\303\250s.\');\n                    setMarketsModalListing(null);\n                    setRefreshKey((k) => k + 1);\n                  }\n                }}\n              >\n                Enregistrer ({selectedMarketsInModal.length} march\303\251{selectedMarketsInModal.length > 1 ? \'s\' : \'\'})\n              </Button>\n            </div>\n          </div>\n        </Modal>\n      )}\n\n      {/* Bulk Import Modal */}"
