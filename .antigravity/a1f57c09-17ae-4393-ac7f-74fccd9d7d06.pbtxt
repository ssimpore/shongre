du March\303\251\', \'Nom public affich\303\251 aux utilisateurs\')}\n                {renderSettingRow(\'general.tagline\', \'Slogan du March\303\251\', \'Accroche commerciale pour ce pays\')}\n                {renderSettingRow(\'general.supportEmail\', \'Email du Support\', \'Adresse email d\303\251di\303\251e au service client local\')}\n                {renderSettingRow(\'general.supportPhone\', \'T\303\251l\303\251phone Support\', \'Num\303\251ro de t\303\251l\303\251phone d\\\'assistance locale\')}\n                {renderSettingRow(\'general.launchState\', \'Mode de D\303\251ploiement\', \'National complet ou villes cibl\303\251es uniquement\')}\n              </>\n            )}\n\n            {activeDomainTab === \'localization\' && (\n              <>\n                {renderSettingRow(\'localization.defaultLocale\', \'Locale par D\303\251faut\', \'Format des dates et nombres (ex: fr-FR, fr-BE, es-ES)\')}\n                {renderSettingRow(\'localization.defaultCurrency\', \'Devise Standard\', \'Code ISO de la devise (ex: EUR, CHF)\')}\n                {renderSettingRow(\'localization.currencySymbol\', \'Symbole Devise\', \'Symbole mon\303\251taire (ex: \342\202\254, CHF)\')}\n                {renderSettingRow(\'localization.timezone\', \'Fuseau Horaire\', \'Identifiant IANA (ex: Europe/Paris, Europe/Brussels)\')}\n                {renderSettingRow(\'localization.phonePrefix\', \'Pr\303\251fixe T\303\251l\303\251phonique\', \'Indicatif international (ex: +33, +32, +34, +41)\')}\n                {renderSettingRow(\'localization.phonePlaceholder\', \'Exemple Num\303\251ro T\303\251l\303\251phone\', \'Format d\\\'aide affich\303\251 dans les formulaires\')}\n                {renderSettingRow(\'localization.postalCodePlaceholder\', \'Exemple Code Postal\', \'Format d\\\'aide dans le champ ville\')}\n                {renderSettingRow(\'localization.postalCodeRegex\', \'Regex Code Postal\', \'Expression r\303\251guli\303\250re validant les codes postaux\')}\n              </>\n            )}\n\n            {activeDomainTab === \'taxonomy\' && (\n              <div className=\"space-y-4\">\n                <div className=\"p-4 bg-amber-50/70 border border-amber-200 rounded-2xl flex items-start gap-3\">\n                  <Info className=\"w-5 h-5 text-amber-700 shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-amber-900 space-y-1\">\n                    <span className=\"font-bold\">Gestion des cat\303\251gories par march\303\251 :</span>\n                    <p>\n                      Par d\303\251faut, tous les march\303\251s h\303\251ritent des cat\303\251gories de la France. Vous pouvez activer ou d\303\251sactiver sp\303\251cifiquement des cat\303\251gories ou sous-cat\303\251gories pour {selectedMarket.name} ({selectedMarket.code}).\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {taxonomyService.getRootNodes().map((rootCat) => {\n                    const isRootEnabled = marketService.isCategoryEnabledInMarket(selectedMarket.code, rootCat.slug);\n                    const disabledCatSlugs = (effectiveConfig.taxonomy?.disabledCategorySlugs || []).map((s) => s.toLowerCase());\n                    const isRootExplicitlyDisabled = disabledCatSlugs.includes(rootCat.slug.toLowerCase());\n\n                    return (\n                      <div\n                        key={rootCat.id}\n                        className={`p-4 rounded-2xl border transition-all ${\n                          isRootEnabled\n                            ? \'bg-white border-border-base shadow-xs\'\n                            : \'bg-stone-50/80 border-stone-200 opacity-75\'\n                        }`}\n                      >\n                        <div className=\"flex items-center justify-between pb-3 border-b border-border-subtle\">\n                          <div className=\"flex items-center gap-2.5\">\n                            <CategoryIcon iconName={rootCat.iconName || \'tag\'} className=\"w-5 h-5 text-primary\" />\n                            <div>\n                              <div className=\"text-xs font-bold text-stone-900\">{rootCat.name}</div>\n                              <div className=\"text-micro text-stone-500\">Slug: {rootCat.slug}</div>\n                            </div>\n                          </div>\n\n                          <div className=\"flex items-center gap-2\">\n                            <span\n                              className={`text-micro font-bold px-2 py-0.5 rounded-full ${\n                                isRootEnabled\n                                  ? \'bg-emerald-100 text-emerald-800\'\n                                  : \'bg-stone-200 text-stone-700\'\n                              }`}\n                            >\n                              {isRootEnabled ? \'Ouverte\' : \'Ferm\303\251e\'}\n                            </span>\n\n                            {canConfigureMarkets && (\n                              <button\n                                type=\"button\"\n                                onClick={() => {\n                                  marketService.setCategoryEnabledInMarket(\n                                    selectedMarket.code,\n                                    rootCat.slug,\n                                    !isRootEnabled,\n                                    false,\n                                    currentUser\n                                  );\n                                  setRefreshTrigger((prev) => prev + 1);\n                                  toast.success(\n                                    `Cat\303\251gorie [${rootCat.name}] ${!isRootEnabled ? \'ouverte\' : \'d\303\251sactiv\303\251e\'} sur ${selectedMarket.name}.`\n                                  );\n                                }}\n                                className={`text-xs px-2.5 py-1 rounded-lg font-bold border transition-colors cursor-pointer ${\n                                  isRootEnabled\n                                    ? \'border-red-200 text-red-700 hover:bg-red-50\'\n                                    : \'border-emerald-200 text-emerald-700 hover:bg-emerald-50\'\n                                }`}\n                              >\n                                {isRootEnabled ? \'D\303\251sactiver\' : \'Activer\'}\n                              </button>\n                            )}\n                          </div>\n                        </div>\n\n                        {/* Subcategories list */}\n                        {rootCat.children && rootCat.children.length > 0 && (\n                          <div className=\"pt-3 space-y-1.5\">\n                            <div className=\"text-micro font-bold text-stone-500 uppercase tracking-wider\">\n                              Sous-cat\303\251gories ({rootCat.children.length})\n                            </div>\n                            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5\">\n                              {rootCat.children.map((sub) => {\n                                const isSubEnabled = isRootEnabled && marketService.isCategoryEnabledInMarket(selectedMarket.code, sub.slug);\n                                return (\n                                  <div\n                                    key={sub.id}\n                                    className={`p-2 rounded-xl border flex items-center justify-between text-xs ${\n                                      isSubEnabled\n                                        ? \'bg-bg-base/40 border-border-subtle text-stone-800\'\n                                        : \'bg-stone-100 border-stone-200 text-stone-500 line-through\'\n                                    }`}\n                                  >\n                                    <span className=\"truncate pr-1 font-medium\">{sub.name}</span>\n                                    {canConfigureMarkets && isRootEnabled && (\n                                      <button\n                                        type=\"button\"\n                                        onClick={() => {\n                                          marketService.setCategoryEnabledInMarket(\n                                            selectedMarket.code,\n                                            sub.slug,\n                                            !isSubEnabled,\n                                            true,\n                                            currentUser\n                                          );\n                                          setRefreshTrigger((prev) => prev + 1);\n                                          toast.success(\n                                            `Sous-cat\303\251gorie [${sub.name}] ${!isSubEnabled ? \'ouverte\' : \'d\303\251sactiv\303\251e\'} sur ${selectedMarket.name}.`\n                                          );\n                                        }}\n                                        className=\"text-micro font-bold text-primary hover:underline ml-1\"\n                                      >\n                                        {isSubEnabled ? \'Fermer\' : \'Ouvrir\'}\n                                      </button>\n                                    )}\n                                  </div>\n                                );\n                              })}\n                            </div>\n                          </div>\n                        )}\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            )}"
    }
