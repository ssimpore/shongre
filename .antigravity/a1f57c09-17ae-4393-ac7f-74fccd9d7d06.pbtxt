      target_content: "          {/* Domain Subtabs */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto pb-2 border-b border-border-subtle\">\n            {[\n              { id: \'general\', label: \'\360\237\217\267\357\270\217 G\303\251n\303\251ral\' },\n              { id: \'localization\', label: \'\360\237\214\220 Localisation\' },\n              { id: \'listings\', label: \'\360\237\223\246 Annonces\' },\n              { id: \'payments\', label: \'\360\237\222\263 Paiements & S\303\251questre\' },\n              { id: \'reservation\', label: \'\360\237\244\235 R\303\251servation\' },\n              { id: \'delivery\', label: \'\360\237\232\232 Livraison\' },\n              { id: \'pro\', label: \'\360\237\222\274 Professionnels\' },\n              { id: \'taxes\', label: \'\360\237\217\233\357\270\217 Fiscalit\303\251 & TVA\' },\n              { id: \'monetization\', label: \'\360\237\232\200 Mon\303\251tisation\' },\n              { id: \'features\', label: \'\342\232\231\357\270\217 Fonctionnalit\303\251s\' },\n            ].map((tab) => (\n              <button\n                key={tab.id}\n                type=\"button\"\n                onClick={() => setActiveDomainTab(tab.id as DomainTab)}\n                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors whitespace-nowrap cursor-pointer ${\n                  activeDomainTab === tab.id\n                    ? \'bg-stone-900 text-white\'\n                    : \'bg-stone-100 text-stone-600 hover:bg-stone-200\'\n                }`}\n              >\n                {tab.label}\n              </button>\n            ))}\n          </div>\n\n          {/* DOMAIN CONFIGURATION CONTENT */}\n          <div className=\"space-y-3\">\n            {activeDomainTab === \'general\' && (\n              <>\n                {renderSettingRow(\'general.name\', \'Nom du March\303\251\', \'Nom public affich\303\251 aux utilisateurs\')}\n                {renderSettingRow(\'general.tagline\', \'Slogan du March\303\251\', \'Accroche commerciale pour ce pays\')}\n                {renderSettingRow(\'general.supportEmail\', \'Email du Support\', \'Adresse email d\303\251di\303\251e au service client local\')}\n                {renderSettingRow(\'general.supportPhone\', \'T\303\251l\303\251phone Support\', \'Num\303\251ro de t\303\251l\303\251phone d\\\'assistance locale\')}\n                {renderSettingRow(\'general.launchState\', \'Mode de D\303\251ploiement\', \'National complet ou villes cibl\303\251es uniquement\')}\n              </>\n            )}\n\n            {activeDomainTab === \'localization\' && (\n              <>\n                {renderSettingRow(\'localization.defaultLocale\', \'Locale par D\303\251faut\', \'Format des dates et nombres (ex: fr-FR, fr-BE, es-ES)\')}\n                {renderSettingRow(\'localization.defaultCurrency\', \'Devise Standard\', \'Code ISO de la devise (ex: EUR, CHF)\')}\n                {renderSettingRow(\'localization.currencySymbol\', \'Symbole Devise\', \'Symbole mon\303\251taire (ex: \342\202\254, CHF)\')}\n                {renderSettingRow(\'localization.timezone\', \'Fuseau Horaire\', \'Identifiant IANA (ex: Europe/Paris, Europe/Brussels)\')}\n                {renderSettingRow(\'localization.phonePrefix\', \'Pr\303\251fixe T\303\251l\303\251phonique\', \'Indicatif international (ex: +33, +32, +34, +41)\')}\n                {renderSettingRow(\'localization.phonePlaceholder\', \'Exemple Num\303\251ro T\303\251l\303\251phone\', \'Format d\\\'aide affich\303\251 dans les formulaires\')}\n                {renderSettingRow(\'localization.postalCodePlaceholder\', \'Exemple Code Postal\', \'Format d\\\'aide dans le champ ville\')}\n                {renderSettingRow(\'localization.postalCodeRegex\', \'Regex Code Postal\', \'Expression r\303\251guli\303\250re validant les codes postaux\')}\n              </>\n            )}"
