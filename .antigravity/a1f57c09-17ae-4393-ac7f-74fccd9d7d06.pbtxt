.ts\n/frontend/src/security/permissions.ts\n/frontend/src/security/roles.config.ts\n/frontend/src/security/useAuthorization.ts\n/frontend/src/services/gemini.service.test.ts\n/frontend/src/services/gemini.service.ts\n/frontend/src/services/prospect-research.service.test.ts\n/frontend/src/services/prospect-research.service.ts\n/frontend/src/services/storage.service.ts\n/frontend/src/types/auth.types.ts\n/frontend/src/types/index.ts\n/frontend/src/utilities/formatters.test.ts\n/frontend/src/utilities/formatters.ts\n/frontend/tsconfig.json\n/frontend/vite.config.ts\n/metadata.json\n/package.json"
