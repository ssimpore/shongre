        }
        lines {
          text: "    const csvContent = [headers.join(\';\'), ...rows.map((r) => r.join(\';\'))].join(\'\\n\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });"
