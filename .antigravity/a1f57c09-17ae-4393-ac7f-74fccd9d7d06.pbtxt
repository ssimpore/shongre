  <span className=\"text-micro font-bold text-stone-600 group-hover:text-primary ml-1\">\n                      ({markets.length})\n                    </span>\n                  </button>\n                );\n              },\n            },\n            {\n              id: \'Prix\',\n              header: \'Prix\',\n              cell: (listing) => (\n                <span className=\"font-bold text-stone-900\">{formatPrice(listing.price)}</span>\n              ),\n            },"
