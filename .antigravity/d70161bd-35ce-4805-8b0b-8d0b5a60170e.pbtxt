        target_content: "import { Breadcrumbs } from \'../../design-system/primitives/UIComponents\';\nimport { Button } from \'../../design-system/primitives/Button\';\n\nexport const ProDirectoryPage: React.FC = () => {\n  const [proSellers, setProSellers] = useState<UserProfile[]>([]);\n  const [search, setSearch] = useState(\'\');\n\n  useEffect(() => {\n    userRepository.getAllProSellers().then(setProSellers);\n  }, []);\n\n  const filtered = proSellers.filter(\n    (s) =>\n      (s.companyName || s.name).toLowerCase().includes(search.toLowerCase()) ||\n      s.city.toLowerCase().includes(search.toLowerCase())\n  );\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n      <Breadcrumbs\n        items={[\n          { label: \'Accueil\', href: \'/\' },\n          { label: \'Annuaire des Boutiques Professionnelles\' },\n        ]}\n      />\n\n      <div className=\"bg-gradient-to-r from-stone-900 to-stone-800 rounded-2xl p-6 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6\">\n        <div className=\"space-y-2 max-w-xl\">\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-bold\">\n            <Building2 className=\"w-3.5 h-3.5\" />\n            Vendeurs Professionnels Agr\303\251\303\251s\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-black text-white\">\n            Trouvez des commer\303\247ants et artisans de confiance\n          </h1>\n          <p className=\"text-xs sm:text-sm text-stone-300\">\n            Toutes les entreprises r\303\251f\303\251renc\303\251es poss\303\250dent un num\303\251ro SIRET v\303\251rifi\303\251 et proposent des garanties professionnelles.\n          </p>\n        </div>\n\n        <Link to=\"/inscription/professionnel\">\n          <Button variant=\"primary\" size=\"lg\" className=\"shrink-0 font-bold\">\n            Ouvrir ma boutique Pro\n          </Button>\n        </Link>\n      </div>\n\n      {/* Search Input */}\n      <div className=\"flex items-center justify-between gap-4\">\n        <div className=\"max-w-md w-full relative\">\n          <Search className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            placeholder=\"Rechercher par nom de boutique ou par ville...\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            className=\"w-full h-11 pl-10 pr-3 bg-white text-xs sm:text-sm rounded-xl border border-border-base focus:outline-none focus:border-primary\"\n          />\n        </div>\n        <span className=\"text-xs text-stone-500 font-semibold\">\n          {filtered.length} boutique{filtered.length > 1 ? \'s\' : \'\'} disponible{filtered.length > 1 ? \'s\' : \'\'}\n        </span>\n      </div>\n\n      {/* Stores Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {filtered.map((seller) => (\n          <SellerCard key={seller.id} user={seller} />\n        ))}\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import { Breadcrumbs } from \'../../design-system/primitives/UIComponents\';\nimport { Button } from \'../../design-system/primitives/Button\';\nimport { NoResultsFound } from \'../../design-system/primitives/NoResultsFound\';\n\nexport const ProDirectoryPage: React.FC = () => {\n  const [proSellers, setProSellers] = useState<UserProfile[]>([]);\n  const [search, setSearch] = useState(\'\');\n\n  useEffect(() => {\n    userRepository.getAllProSellers().then(setProSellers);\n  }, []);\n\n  const filtered = proSellers.filter(\n    (s) =>\n      (s.companyName || s.name).toLowerCase().includes(search.toLowerCase()) ||\n      s.city.toLowerCase().includes(search.toLowerCase())\n  );\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n      <Breadcrumbs\n        items={[\n          { label: \'Accueil\', href: \'/\' },\n          { label: \'Annuaire des Boutiques Professionnelles\' },\n        ]}\n      />\n\n      <div className=\"bg-gradient-to-r from-stone-900 to-stone-800 rounded-2xl p-6 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6\">\n        <div className=\"space-y-2 max-w-xl\">\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-bold\">\n            <Building2 className=\"w-3.5 h-3.5\" />\n            Vendeurs Professionnels Agr\303\251\303\251s\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-black text-white\">\n            Trouvez des commer\303\247ants et artisans de confiance\n          </h1>\n          <p className=\"text-xs sm:text-sm text-stone-300\">\n            Toutes les entreprises r\303\251f\303\251renc\303\251es poss\303\250dent un num\303\251ro SIRET v\303\251rifi\303\251 et proposent des garanties professionnelles.\n          </p>\n        </div>\n\n        <Link to=\"/inscription/professionnel\">\n          <Button variant=\"primary\" size=\"lg\" className=\"shrink-0 font-bold\">\n            Ouvrir ma boutique Pro\n          </Button>\n        </Link>\n      </div>\n\n      {/* Search Input */}\n      <div className=\"flex items-center justify-between gap-4\">\n        <div className=\"max-w-md w-full relative\">\n          <Search className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            placeholder=\"Rechercher par nom de boutique ou par ville...\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            className=\"w-full h-11 pl-10 pr-3 bg-white text-xs sm:text-sm rounded-xl border border-border-base focus:outline-none focus:border-primary\"\n          />\n        </div>\n        <span className=\"text-xs text-stone-500 font-semibold\">\n          {filtered.length} boutique{filtered.length > 1 ? \'s\' : \'\'} disponible{filtered.length > 1 ? \'s\' : \'\'}\n        </span>\n      </div>\n\n      {/* Stores Grid or Empty State */}\n      {filtered.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {filtered.map((seller) => (\n            <SellerCard key={seller.id} user={seller} />\n          ))}\n        </div>\n      ) : (\n        <NoResultsFound\n          id=\"pro-directory-no-results\"\n          query={search}\n          title=\"Aucune boutique professionnelle trouv\303\251e\"\n          description=\"Aucun commer\303\247ant ou artisan ne correspond \303\240 votre recherche par nom ou par ville.\"\n          onClearFilters={() => setSearch(\'\')}\n          clearFiltersLabel=\"Effacer la recherche\"\n        />\n      )}\n    </div>\n  );\n};"
