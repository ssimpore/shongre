    instruction: "Convert category selection in sidebar to a clean dropdown selector with subcategory support"
    replacement_infos {
      original_chunk {
        target_content: "              {/* Categories */}\n              <div>\n                <h2 className=\"text-xs font-bold text-stone-900 uppercase tracking-wider mb-3\">\n                  Cat\303\251gories\n                </h2>\n                <div className=\"space-y-1 text-xs font-medium\">\n                  <button\n                    type=\"button\"\n                    onClick={() => updateFilter(\'category\', undefined)}\n                    className={`w-full text-left px-2 py-1.5 rounded-lg transition-colors cursor-pointer ${\n                      !categorySlug ? \'bg-primary-light text-primary font-bold\' : \'text-stone-700 hover:bg-stone-50\'\n                    }`}\n                  >\n                    Toutes les cat\303\251gories\n                  </button>\n                  {TAXONOMY.map((cat) => (\n                    <button\n                      key={cat.id}\n                      type=\"button\"\n                      onClick={() => updateFilter(\'category\', cat.slug)}\n                      title={cat.name}\n                      className={`w-full text-left px-2 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center justify-between group ${\n                        categorySlug === cat.slug\n                           ? \'bg-primary-light text-primary font-bold\'\n                           : \'text-stone-700 hover:bg-stone-50\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-2 truncate\">\n                        <CategoryIcon category={cat} size=\"xs\" />\n                        <span className=\"truncate\">{getTaxonomyLabel(cat, \'compact\')}</span>\n                      </div>\n                    </button>\n                  ))}\n                </div>\n              </div>"
        replacement_content: "              {/* Categories */}\n              <div>\n                <label\n                  htmlFor=\"desktop-category-select\"\n                  className=\"text-xs font-bold text-stone-900 uppercase tracking-wider block mb-2\"\n                >\n                  Cat\303\251gories\n                </label>\n                <div className=\"space-y-2.5\">\n                  <Select\n                    id=\"desktop-category-select\"\n                    value={categorySlug || \'\'}\n                    onChange={(e) => {\n                      const val = e.target.value;\n                      const next = new URLSearchParams(searchParams);\n                      if (val) {\n                        next.set(\'category\', val);\n                      } else {\n                        next.delete(\'category\');\n                      }\n                      next.delete(\'subCategory\');\n                      next.delete(\'page\');\n                      setSearchParams(next);\n                    }}\n                  >\n                    <option value=\"\">Toutes les cat\303\251gories</option>\n                    {TAXONOMY.map((cat) => (\n                      <option key={cat.id} value={cat.slug}>\n                        {cat.name}\n                      </option>\n                    ))}\n                  </Select>\n\n                  {/* Subcategory dropdown when category with children is active */}\n                  {(() => {\n                    const activeCatNode = TAXONOMY.find((c) => c.slug === categorySlug);\n                    if (activeCatNode?.children && activeCatNode.children.length > 0) {\n                      return (\n                        <div className=\"pt-1\">\n                          <label\n                            htmlFor=\"desktop-subcategory-select\"\n                            className=\"text-[11px] font-semibold text-stone-600 block mb-1.5\"\n                          >\n                            Sous-cat\303\251gorie\n                          </label>\n                          <Select\n                            id=\"desktop-subcategory-select\"\n                            value={subCategorySlug || \'\'}\n                            onChange={(e) => {\n                              const val = e.target.value;\n                              const next = new URLSearchParams(searchParams);\n                              if (val) {\n                                next.set(\'subCategory\', val);\n                              } else {\n                                next.delete(\'subCategory\');\n                              }\n                              next.delete(\'page\');\n                              setSearchParams(next);\n                            }}\n                          >\n                            <option value=\"\">Toutes les sous-cat\303\251gories</option>\n                            {activeCatNode.children.map((sub) => (\n                              <option key={sub.id} value={sub.slug}>\n                                {sub.name}\n                              </option>\n                            ))}\n                          </Select>\n                        </div>\n                      );\n                    }\n                    return null;\n                  })()}\n                </div>\n              </div>"
      }
      num_matches: 1
    }
  }
}
