    instruction: "Use taxonomyService to get active category node and its children for the dropdown selectors"
    replacement_infos {
      original_chunk {
        target_content: "                  {/* Subcategory dropdown when category with children is active */}\n                  {(() => {\n                    const activeCatNode = TAXONOMY.find((c) => c.slug === categorySlug);\n                    if (activeCatNode?.children && activeCatNode.children.length > 0) {\n                      return (\n                        <div className=\"pt-1\">\n                          <label\n                            htmlFor=\"desktop-subcategory-select\"\n                            className=\"text-[11px] font-semibold text-stone-600 block mb-1.5\"\n                          >\n                            Sous-cat\303\251gorie\n                          </label>\n                          <Select\n                            id=\"desktop-subcategory-select\"\n                            value={subCategorySlug || \'\'}\n                            onChange={(e) => {\n                              const val = e.target.value;\n                              const next = new URLSearchParams(searchParams);\n                              if (val) {\n                                next.set(\'subCategory\', val);\n                              } else {\n                                next.delete(\'subCategory\');\n                              }\n                              next.delete(\'page\');\n                              setSearchParams(next);\n                            }}\n                          >\n                            <option value=\"\">Toutes les sous-cat\303\251gories</option>\n                            {activeCatNode.children.map((sub) => (\n                              <option key={sub.id} value={sub.slug}>\n                                {sub.name}\n                              </option>\n                            ))}\n                          </Select>\n                        </div>\n                      );\n                    }\n                    return null;\n                  })()}"
        replacement_content: "                  {/* Subcategory dropdown when category with children is active */}\n                  {(() => {\n                    const activeNode = categorySlug ? taxonomyService.getNodeBySlug(categorySlug) : undefined;\n                    const children = activeNode ? taxonomyService.getChildren(activeNode.id) : [];\n                    if (children.length > 0) {\n                      return (\n                        <div className=\"pt-1\">\n                          <label\n                            htmlFor=\"desktop-subcategory-select\"\n                            className=\"text-[11px] font-semibold text-stone-600 block mb-1.5\"\n                          >\n                            Sous-cat\303\251gorie\n                          </label>\n                          <Select\n                            id=\"desktop-subcategory-select\"\n                            value={subCategorySlug || \'\'}\n                            onChange={(e) => {\n                              const val = e.target.value;\n                              const next = new URLSearchParams(searchParams);\n                              if (val) {\n                                next.set(\'subCategory\', val);\n                              } else {\n                                next.delete(\'subCategory\');\n                              }\n                              next.delete(\'page\');\n                              setSearchParams(next);\n                            }}\n                          >\n                            <option value=\"\">Toutes les sous-cat\303\251gories</option>\n                            {children.map((sub) => (\n                              <option key={sub.id} value={sub.slug}>\n                                {getTaxonomyLabel(sub, \'compact\')}\n                              </option>\n                            ))}\n                          </Select>\n                        </div>\n                      );\n                    }\n                    return null;\n                  })()}"
      }
