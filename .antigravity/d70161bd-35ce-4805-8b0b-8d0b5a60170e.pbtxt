  file_change {
    absolute_path_uri: "file:///frontend/src/design-system/primitives/SearchAutocomplete.test.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { describe, it, expect, vi } from \'vitest\';\nimport { render, screen, fireEvent } from \'@testing-library/react\';\nimport React from \'react\';\nimport {\n  SearchAutocomplete,\n  HighlightMatch,\n  AutocompleteSelection,\n} from \'./SearchAutocomplete\';\nimport { getSearchSuggestions } from \'../../configuration/search.config\';\n\ndescribe(\'HighlightMatch\', () => {\n  it(\'renders standard text when no highlight is given\', () => {\n    render(<HighlightMatch text=\"V\303\251lo gravel\" highlight=\"\" />);\n    expect(screen.getByText(\'V\303\251lo gravel\')).toBeInTheDocument();\n  });\n\n  it(\'highlights matching case-insensitive substring\', () => {\n    const { container } = render(<HighlightMatch text=\"V\303\251lo gravel\" highlight=\"gravel\" />);\n    const match = container.querySelector(\'span.font-bold\');\n    expect(match).toBeInTheDocument();\n    expect(match?.textContent).toBe(\'gravel\');\n  });\n});\n\ndescribe(\'getSearchSuggestions\', () => {\n  it(\'returns empty matched categories and keywords when query is empty\', () => {\n    const results = getSearchSuggestions(\'\');\n    expect(results.categories).toHaveLength(0);\n    expect(results.keywords).toHaveLength(0);\n    expect(results.trending.length).toBeGreaterThan(0);\n  });\n\n  it(\'matches categories when typing category name or keyword\', () => {\n    const results = getSearchSuggestions(\'vehic\');\n    expect(results.categories.some((c) => c.slug === \'vehicules\' || c.parentSlug === \'vehicules\')).toBe(true);\n  });\n\n  it(\'matches keywords for tech searches\', () => {\n    const results = getSearchSuggestions(\'iPhone\');\n    expect(results.keywords.some((k) => k.keyword.toLowerCase().includes(\'iphone\'))).toBe(true);\n  });\n});\n\ndescribe(\'SearchAutocomplete component\', () => {\n  const dummyCategories = [\n    {\n      id: \'cat-1\',\n      name: \'V\303\251hicules\',\n      slug: \'vehicules\',\n      compactLabel: \'V\303\251hicules\',\n      isSubCategory: false,\n      categoryObj: {\n        id: \'cat-1\',\n        name: \'V\303\251hicules\',\n        slug: \'vehicules\',\n        icon: \'Car\',\n        subCategories: [],\n      } as any,\n    },\n  ];\n\n  const dummyKeywords = [\n    {\n      keyword: \'V\303\251lo gravel\',\n      categorySlug: \'loisirs\',\n      subCategorySlug: \'loisirs.velos\',\n      isTrending: true,\n    },\n  ];\n\n  const dummyTrending = [\n    {\n      keyword: \'PlayStation 5\',\n      categorySlug: \'multimedia\',\n      isTrending: true,\n    },\n  ];\n\n  it(\'does not render when isOpen is false\', () => {\n    const { container } = render(\n      <SearchAutocomplete\n        isOpen={false}\n        query=\"velo\"\n        categories={dummyCategories}\n        keywords={dummyKeywords}\n        trending={dummyTrending}\n        recentSearches={[]}\n        selectedIndex={-1}\n        onSelect={vi.fn()}\n        onClose={vi.fn()}\n      />\n    );\n    expect(container.firstChild).toBeNull();\n  });\n\n  it(\'renders category and keyword suggestions when typing\', () => {\n    const onSelect = vi.fn();\n\n    render(\n      <SearchAutocomplete\n        isOpen={true}\n        query=\"velo\"\n        categories={dummyCategories}\n        keywords={dummyKeywords}\n        trending={dummyTrending}\n        recentSearches={[]}\n        selectedIndex={-1}\n        onSelect={onSelect}\n        onClose={vi.fn()}\n      />\n    );\n\n    expect(screen.getByText(\'Cat\303\251gories & Rayons\')).toBeInTheDocument();\n    expect(screen.getByText(\'Suggestions de recherche\')).toBeInTheDocument();\n    expect(screen.getByText(\'V\303\251hicules\')).toBeInTheDocument();\n    expect(screen.getByText(\'V\303\251lo gravel\')).toBeInTheDocument();\n  });\n\n  it(\'calls onSelect when clicking a category suggestion\', () => {\n    const onSelect = vi.fn();\n\n    render(\n      <SearchAutocomplete\n        isOpen={true}\n        query=\"vehic\"\n        categories={dummyCategories}\n        keywords={[]}\n        trending={[]}\n        recentSearches={[]}\n        selectedIndex={-1}\n        onSelect={onSelect}\n        onClose={vi.fn()}\n      />\n    );\n\n    const catItem = screen.getByText(\'V\303\251hicules\');\n    fireEvent.mouseDown(catItem);\n\n    expect(onSelect).toHaveBeenCalledWith(\n      expect.objectContaining({\n        categorySlug: \'vehicules\',\n        submitImmediately: true,\n      })\n    );\n  });\n\n  it(\'renders recent searches and trending keywords when query is empty\', () => {\n    const onSelect = vi.fn();\n    const onClearRecent = vi.fn();\n\n    render(\n      <SearchAutocomplete\n        isOpen={true}\n        query=\"\"\n        categories={[]}\n        keywords={[]}\n        trending={dummyTrending}\n        recentSearches={[\'MacBook M3\', \'Appartement T2\']}\n        selectedIndex={-1}\n        onSelect={onSelect}\n        onClearRecentSearch={onClearRecent}\n        onClose={vi.fn()}\n      />\n    );\n\n    expect(screen.getByText(\'Recherches r\303\251centes\')).toBeInTheDocument();\n    expect(screen.getByText(\'MacBook M3\')).toBeInTheDocument();\n    expect(screen.getByText(\'Recherches les plus populaires\')).toBeInTheDocument();\n    expect(screen.getByText(\'PlayStation 5\')).toBeInTheDocument();\n  });\n});\n"
    }
