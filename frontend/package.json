{
  "name": "shongre-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "shongre": "./bin/shongre.js"
  },
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && node scripts/check-design-tokens.mjs && node scripts/normalize-control-metrics.mjs --check && node scripts/check-i18n-coverage.mjs",
    "test": "vitest run",
    "check": "node ./bin/shongre.js check",
    "cli": "node ./bin/shongre.js",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:design-system": "node scripts/check-design-tokens.mjs",
    "check:control-metrics": "node scripts/normalize-control-metrics.mjs --check",
    "fix:control-metrics": "node scripts/normalize-control-metrics.mjs",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test responsive.spec.ts --project=chromium",
    "test:e2e:a11y": "playwright test accessibility.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "check:i18n": "node scripts/check-i18n-coverage.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
