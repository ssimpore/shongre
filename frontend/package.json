{
  "name": "shongre-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "shongre": "./bin/shongre.js"
  },
  "scripts": {
    "predev": "npm run build --workspace=@shongre/design-tokens",
    "dev": "node scripts/next-cli.mjs dev",
    "prebuild": "npm run build --workspace=@shongre/design-tokens && npm run check:taxonomy",
    "build": "next build",
    "preview": "node scripts/next-cli.mjs start",
    "start": "node scripts/next-cli.mjs start",
    "clean": "rm -rf .next out server.js",
    "lint": "tsc --noEmit && node scripts/check-design-tokens.mjs && node scripts/normalize-control-metrics.mjs --check && node scripts/check-i18n-coverage.mjs && node scripts/check-navigation-integrity.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace=@shongre/design-tokens",
    "test": "vitest run",
    "test:critical": "vitest run src/security src/api/adapters/demo/demo-payments.service.test.ts src/api/adapters/demo/demo-promotions.service.test.ts src/domains/publication src/domains/messaging src/domains/transaction src/domains/verification src/services/storage.favorites.test.ts",
    "test:crm": "vitest run src/api/adapters/demo/demo-crm.service.test.ts src/api/adapters/demo/demo-prospecting.service.test.ts src/api/adapters/demo/demo-provider-control-plane.service.test.ts src/api/client/service-registry.test.ts",
    "test:marketing": "vitest run src/api/adapters/demo/demo-marketing.service.test.ts src/api/client/service-registry.test.ts",
    "check": "node ./bin/shongre.js check",
    "cli": "node ./bin/shongre.js",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:design-system": "node scripts/check-design-tokens.mjs",
    "check:control-metrics": "node scripts/normalize-control-metrics.mjs --check",
    "fix:control-metrics": "node scripts/normalize-control-metrics.mjs",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test responsive.spec.ts --project=chromium",
    "test:e2e:a11y": "playwright test accessibility.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "check:taxonomy": "tsx scripts/check-taxonomy-coverage.ts",
    "check:navigation": "node scripts/check-navigation-integrity.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/browser": "^10.71.0",
    "@shongre/brand": "1.0.0",
    "@shongre/contracts": "1.0.0",
    "@shongre/design-tokens": "1.0.0",
    "@shongre/features": "1.0.0",
    "@shongre/shared": "1.0.0",
    "@shongre/ui": "1.0.0",
    "@tanstack/react-query": "^5.101.4",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "next": "16.3.1",
    "posthog-js": "^1.421.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "web-vitals": "^5.3.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-arm64-musl": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^3.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
