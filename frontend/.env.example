# ==============================================================================
# Shongre Frontend Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to frontend/.env for local development.

# Server Port
PORT=3000

# Application Metadata
VITE_APP_NAME="Shongre Marketplace & Escrow Platform"
VITE_APP_URL=http://localhost:3000

# Marketplace Defaults (Canonical Market: France)
VITE_DEFAULT_COUNTRY_CODE=FR
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=fr-FR

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_MOCK_STORAGE=true
VITE_DATA_MODE=demo

# Optional: Google Gemini AI API Key for Live AI Assistance & Screening
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
