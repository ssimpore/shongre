# Safe, commit-ready staging defaults. Put credentials only in the ignored
# .env.staging.local file or the deployment secret store.
APP_ENV=staging
NODE_ENV=development

# The application still runs on this machine and is published by Cloudflare.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
E2E_FRONTEND_PORT=3110
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
EXPO_HOST=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_WEB_PORT=8082
STORYBOOK_PORT=6006

# These ports remain defined for tooling, but hosted mode does not start them.
SUPABASE_HOST=127.0.0.1
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_SHADOW_PORT=54320
SUPABASE_REALTIME_PORT=54323
SUPABASE_STUDIO_PORT=54324
SUPABASE_INBUCKET_PORT=54325
SUPABASE_SMTP_PORT=54326
SUPABASE_POP3_PORT=54327
SUPABASE_POOLER_PORT=54329

NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_API_URL=https://api-staging.shongre.fr/api/v1
NEXT_PUBLIC_APP_NAME=Shongre
NEXT_PUBLIC_APP_URL=https://staging.shongre.fr
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=FR
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_LOCALE=fr-FR
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=false
NEXT_PUBLIC_SHONGRE_GLOBAL_DOMAIN=staging.shongre.com
NEXT_PUBLIC_SHONGRE_FR_DOMAIN=staging.shongre.fr
NEXT_PUBLIC_SHONGRE_CANONICAL_PROTOCOL=https

VITE_DATA_MODE=api
VITE_API_URL=https://api-staging.shongre.fr/api/v1
VITE_APP_NAME=Shongre
VITE_APP_URL=https://staging.shongre.fr
VITE_DEFAULT_COUNTRY_CODE=FR
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=fr-FR
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_MOCK_STORAGE=false

SHONGRE_GLOBAL_DOMAIN=staging.shongre.com
SHONGRE_FR_DOMAIN=staging.shongre.fr
SHONGRE_CANONICAL_PROTOCOL=https
SHONGRE_TRUST_PROXY_HOST=false
SHONGRE_ALLOWED_DEV_ORIGINS=staging.shongre.fr,staging.shongre.com

API_PREFIX=/api/v1
BACKEND_DATA_MODE=database
DATABASE_INFRA_MODE=hosted
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000
FRONTEND_URL=https://staging.shongre.fr
PUBLIC_API_URL=https://api-staging.shongre.fr
CORS_ORIGIN=https://staging.shongre.fr,https://staging.shongre.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=api-staging.shongre.fr

# Required hosted Supabase values. Keep all real values out of this file.
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
HANDOVER_PIN_PEPPER=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_BASE64=
PROVIDER_CREDENTIAL_KEY_VERSION=staging-v1

# Staging exercises the real database while external paid/compliance providers
# remain deterministic until their sandbox credentials are approved.
PAYMENT_PROVIDER=demo
KYC_PROVIDER=demo
BUSINESS_REGISTRY_PROVIDER=demo
AI_PROVIDER=demo

ENABLE_EMAIL_PASSWORD_AUTH=true
ENABLE_SOCIAL_AUTH=false
ENABLE_ACCOUNT_LINKING=false
ENABLE_GOOGLE_AUTH=false
ENABLE_APPLE_AUTH=false
ENABLE_FACEBOOK_AUTH=false
OAUTH_ALLOWED_RETURN_ORIGINS=https://staging.shongre.fr,https://staging.shongre.com
MOBILE_AUTH_CALLBACK_URL=shongre://auth/callback
GOOGLE_OAUTH_CALLBACK_URL=https://api-staging.shongre.fr/api/v1/auth/oauth/google/callback
APPLE_OAUTH_CALLBACK_URL=https://api-staging.shongre.fr/api/v1/auth/oauth/apple/callback
FACEBOOK_OAUTH_CALLBACK_URL=https://api-staging.shongre.fr/api/v1/auth/oauth/facebook/callback

EXPO_PUBLIC_DATA_MODE=api
EXPO_PUBLIC_API_URL=https://api-staging.shongre.fr/api/v1
EXPO_PUBLIC_WEB_URL=https://staging.shongre.com
EXPO_PUBLIC_FRANCE_WEB_URL=https://staging.shongre.fr
EXPO_PUBLIC_GLOBAL_WEB_URL=https://staging.shongre.com
EXPO_PUBLIC_PRIVACY_URL=https://staging.shongre.com/privacy
EXPO_PUBLIC_TERMS_URL=https://staging.shongre.com/terms
EXPO_PUBLIC_SUPPORT_URL=https://staging.shongre.com/support
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://staging.shongre.com/account/delete

IOS_BUNDLE_IDENTIFIER=com.shongre.marketplace
ANDROID_PACKAGE_NAME=com.shongre.marketplace
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
