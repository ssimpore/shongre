{
  "name": "shongre-platform-monorepo",
  "private": true,
  "engines": {
    "node": ">=22 <27",
    "npm": ">=10"
  },
  "workspaces": [
    "frontend",
    "backend",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "make dev",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "make build",
    "build:frontend": "make frontend-build",
    "build:backend": "npm run build --workspace=backend",
    "lint": "make lint",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "test": "make test",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:backend:unit": "npm run test:unit --workspace=backend",
    "test:backend:integration": "npm run test:integration --workspace=backend",
    "test:backend:rls": "npm run test:rls --workspace=backend",
    "test:backend:security": "npm run test:security --workspace=backend",
    "test:backend:watch": "npm run test:watch --workspace=backend",
    "benchmark:backend": "npm run benchmark --workspace=backend",
    "check:boundary": "node backend/scripts/maintenance/check-boundary.js",
    "check:frontend": "npm run check --workspace=frontend",
    "check:backend": "npm run lint --workspace=backend && npm run test --workspace=backend && npm run build --workspace=backend && npm run benchmark --workspace=backend && npm run check:boundary",
    "check": "make check",
    "tokens:check": "make tokens-check",
    "ui:check": "make ui-check",
    "cross-platform:check": "make cross-platform-check",
    "openapi:lint": "redocly lint backend/openapi/openapi.json --format=stylish --max-problems=1000",
    "openapi:generate": "openapi-typescript backend/openapi/openapi.json --output packages/contracts/src/generated/openapi.ts --immutable --alphabetize && node backend/scripts/openapi/generate-manifest.mjs && node backend/scripts/openapi/generate-inventory.mjs",
    "openapi:check": "npm run openapi:lint && openapi-typescript backend/openapi/openapi.json --output packages/contracts/src/generated/openapi.ts --immutable --alphabetize --check && node backend/scripts/openapi/generate-manifest.mjs --check && node backend/scripts/openapi/generate-inventory.mjs --check && node backend/scripts/openapi/check-contract.mjs",
    "openapi:docs": "redocly build-docs backend/openapi/openapi.json --output backend/docs/generated/openapi.html",
    "openapi:breaking": "node backend/scripts/openapi/check-breaking-change.mjs",
    "preview": "npm run start --workspace=frontend"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.3",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@redocly/cli": "^2.47.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.3",
    "uuid": "^11.1.1"
  }
}
