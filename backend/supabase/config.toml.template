# Generated by scripts/render-supabase-config.sh. Do not duplicate host ports in
# this file; placeholders resolve from the root environment.
project_id = "shongre-platform"

[api]
enabled = true
port = {{SUPABASE_API_PORT}}
schemas = ["public", "storage", "graphql_public"]
extra_search_path = ["public", "extensions"]
max_rows = 1000

[db]
port = {{SUPABASE_DB_PORT}}
shadow_port = {{SUPABASE_SHADOW_PORT}}
major_version = 15

[db.pooler]
enabled = false
port = {{SUPABASE_POOLER_PORT}}
pool_mode = "transaction"
default_pool_size = 20
max_client_conn = 100

[realtime]
enabled = true
port = {{SUPABASE_REALTIME_PORT}}
ip_version = "IPv4"

[studio]
enabled = true
port = {{SUPABASE_STUDIO_PORT}}
api_url = "http://{{SUPABASE_HOST}}:{{SUPABASE_API_PORT}}"

[local_smtp]
enabled = true
port = {{SUPABASE_INBUCKET_PORT}}
smtp_port = {{SUPABASE_SMTP_PORT}}
pop3_port = {{SUPABASE_POP3_PORT}}

[storage]
enabled = true
file_size_limit = "50MiB"

[storage.buckets.listing-media]
public = true
file_size_limit = "15MiB"
allowed_mime_types = ["image/jpeg", "image/png", "image/webp"]

[storage.buckets.kyc-documents]
public = false
file_size_limit = "10MiB"
allowed_mime_types = ["image/jpeg", "image/png", "application/pdf"]

[storage.buckets.avatars]
public = true
file_size_limit = "5MiB"
allowed_mime_types = ["image/jpeg", "image/png", "image/webp"]

[auth]
enabled = true
site_url = "{{PUBLIC_FR_URL}}"
additional_redirect_urls = ["{{PUBLIC_FR_URL}}", "{{PUBLIC_INTL_URL}}"]
jwt_expiry = 3600
enable_signup = true

[auth.email]
enable_signup = true
double_confirm_changes = true
enable_confirmations = true

[auth.sms]
enable_signup = true
enable_confirmations = true
template = "Votre code de confirmation Shongre est: {{ .Code }}"
