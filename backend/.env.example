# ==============================================================================
# Shongre Backend Environment Configuration
# ==============================================================================
# NOTE: Never commit production credentials. Copy this file to .env locally.

# Environment & Server
NODE_ENV=development
PORT=4000
BACKEND_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Central Backend Data Mode: "demo" (in-memory repositories) | "database" (PostgreSQL/Supabase)
BACKEND_DATA_MODE=demo

# External Provider Modes: "demo" | "stripe", "demo" | "live", "demo" | "siret", "demo" | "gemini"
PAYMENT_PROVIDER=demo
KYC_PROVIDER=demo
BUSINESS_REGISTRY_PROVIDER=demo
AI_PROVIDER=demo

# Supabase Infrastructure (Required for BACKEND_DATA_MODE=database)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=dummy-anon-key
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# JWT & Authentication Secret
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

# Stripe Payments & Escrow (Required for PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLIC_KEY=pk_test_...

# Gemini AI / LLM Integration (Required for AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
