# ==============================================================================
# Shongre Backend Environment Configuration Example
# ==============================================================================
# NOTE: Never commit production credentials. Copy this file to .env locally.

# Environment & Server
NODE_ENV=development
PORT=4000
BACKEND_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Supabase Infrastructure
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# JWT & Authentication Secret
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

# Stripe Payments & Escrow
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLIC_KEY=pk_test_...

# Gemini AI / LLM Integration
GEMINI_API_KEY=your-gemini-api-key

# Transactional Email (Resend / SendGrid / Mock)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=re_...
EMAIL_FROM="Shongre <notifications@shongre.com>"

# SMS OTP Provider (Twilio / Mock)
SMS_PROVIDER=mock
SMS_ACCOUNT_SID=AC...
SMS_AUTH_TOKEN=...
SMS_FROM=+33600000000

# KYC / Business Verification Provider
KYC_PROVIDER=mock
KYC_API_KEY=...
INSEE_SIRENE_API_KEY=...
