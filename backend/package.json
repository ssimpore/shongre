{
  "name": "shongre-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/app/server/index.ts",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:rls": "vitest run tests/rls",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "benchmark": "tsx scripts/benchmark/benchmark.ts",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:seed": "tsx scripts/seed/seed.ts",
    "db:backfill:monetization": "tsx scripts/monetization/import-baseline.ts",
    "db:dry-run:unified-discovery": "tsx scripts/maintenance/unified-discovery-dry-run.ts",
    "db:types": "tsx scripts/generate-types/generate-types.ts",
    "check:boundary": "node scripts/maintenance/check-boundary.js"
  },
  "dependencies": {
    "@shongre/contracts": "*",
    "@shongre/shared": "*",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "vitest": "^3.0.8"
  }
}
