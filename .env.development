# Commit-safe shared development deployment configuration.
APP_ENV=development
ENVIRONMENT_ID=shongre-development
API_ENVIRONMENT_ID=shongre-development
DATABASE_ENVIRONMENT_ID=shongre-development
SUPABASE_ENVIRONMENT_ID=shongre-development
STORAGE_ENVIRONMENT_ID=shongre-development
NODE_ENV=production
PUBLIC_FR_URL=https://dev.shongre.fr
PUBLIC_INTL_URL=https://dev.shongre.com
API_URL=https://api-dev.shongre.fr

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
E2E_FRONTEND_PORT=3110
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
EXPO_HOST=127.0.0.1
EXPO_METRO_PORT=8081
EXPO_WEB_PORT=8082
STORYBOOK_PORT=6006
SUPABASE_HOST=127.0.0.1
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_SHADOW_PORT=54320
SUPABASE_REALTIME_PORT=54323
SUPABASE_STUDIO_PORT=54324
SUPABASE_INBUCKET_PORT=54325
SUPABASE_SMTP_PORT=54326
SUPABASE_POP3_PORT=54327
SUPABASE_POOLER_PORT=54329

API_PREFIX=/api/v1
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_APP_NAME=Shongre
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=false
SHONGRE_TRUST_PROXY_HOST=true
SHONGRE_TRUST_PROXY_IP=true
SHONGRE_ALLOWED_DEV_ORIGINS=dev.shongre.fr,dev.shongre.com
BACKEND_DATA_MODE=database
DATABASE_INFRA_MODE=hosted
CORS_ORIGIN=https://dev.shongre.fr,https://dev.shongre.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000

DATABASE_URL=
SUPABASE_PROJECT_REF=
EXPECTED_SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
HANDOVER_PIN_PEPPER=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_BASE64=
PROVIDER_CREDENTIAL_KEY_VERSION=development-v1

PAYMENT_MODE=test
PAYMENT_PROVIDER=demo
EMAIL_MODE=sandbox
EMAIL_RECIPIENT_ALLOWLIST=
AI_MODE=development
ANALYTICS_MODE=development
KYC_PROVIDER=demo
BUSINESS_REGISTRY_PROVIDER=demo
AI_PROVIDER=demo
ENABLE_EMAIL_PASSWORD_AUTH=true
ENABLE_SOCIAL_AUTH=false
ENABLE_ACCOUNT_LINKING=false
ENABLE_GOOGLE_AUTH=false
ENABLE_APPLE_AUTH=false
ENABLE_FACEBOOK_AUTH=false
OAUTH_ALLOWED_RETURN_ORIGINS=
MOBILE_AUTH_CALLBACK_URL=shongre://auth/callback

EXPO_PUBLIC_DATA_MODE=api
IOS_BUNDLE_IDENTIFIER=com.shongre.marketplace.dev
ANDROID_PACKAGE_NAME=com.shongre.marketplace.dev
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
