{
  "name": "shongre-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/expo-cli.mjs start",
    "ios": "node scripts/expo-cli.mjs run:ios",
    "android": "node scripts/expo-cli.mjs run:android",
    "web": "node scripts/expo-cli.mjs start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dead-code": "node scripts/dead-code-check.mjs",
    "check:runtime-resolution": "node scripts/expo-cli.mjs --check-workspace-resolution",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:runtime-resolution && npm run dead-code"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.14",
    "@shongre/contracts": "1.0.0",
    "@shongre/design-tokens": "1.0.0",
    "@shongre/features": "1.0.0",
    "@shongre/shared": "1.0.0",
    "@shongre/ui": "1.0.0",
    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
